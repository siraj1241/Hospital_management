# ─── Supabase Configuration ────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-secret-key-here

# ─── What each key does ────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL              → Your Supabase project URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  → Safe to show in browser (read-only with RLS)
# SUPABASE_SECRET_KEY                   → Server-only secret (bypasses RLS) — NEVER expose to frontend
